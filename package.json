{
	"name": "wp-publisher-for-obsidian",
	"version": "1.0.2",
	"description": "Publish and explicitly synchronize notes with WordPress using Gutenberg blocks, media reuse, previews, and guarded pull and merge workflows.",
	"private": true,
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
		"check": "npm run lint && npm test && npm run build",
		"release:check": "node scripts/release-check.mjs",
		"version:set": "node scripts/set-version.mjs"
	},
	"keywords": [
		"wp",
		"wordpress",
		"obsidian",
		"plugin"
	],
	"author": "Irisable",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/irisable/wp-publisher-for-obsidian.git"
	},
	"bugs": {
		"url": "https://github.com/irisable/wp-publisher-for-obsidian/issues"
	},
	"homepage": "https://github.com/irisable/wp-publisher-for-obsidian#readme",
	"engines": {
		"node": ">=22.6"
	},
	"devDependencies": {
		"@types/js-yaml": "4.0.9",
		"@types/lodash-es": "4.17.12",
		"@types/markdown-it": "14.1.2",
		"@types/node": "22.14.1",
		"@typescript-eslint/eslint-plugin": "8.30.1",
		"@typescript-eslint/parser": "8.30.1",
		"builtin-modules": "5.0.0",
		"date-fns": "4.1.0",
		"esbuild": "0.25.2",
		"eslint": "9.20.0",
		"file-type-checker": "1.1.4",
		"imask": "7.6.1",
		"juice": "11.0.1",
		"lodash-es": "4.17.21",
		"markdown-it": "14.1.0",
		"mathjax-full": "3.2.2",
		"obsidian": "1.8.7",
		"parse5": "7.3.0",
		"tslib": "2.8.1",
		"typescript": "5.8.3"
	}
}
